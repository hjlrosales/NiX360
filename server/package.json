{
  "name": "@nix360/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "worker": "node src/index.ts --worker",
    "migrate": "node src/scripts/migrate.ts",
    "backup": "node src/scripts/backup.ts",
    "bootstrap-admin": "node src/scripts/bootstrap-admin.ts",
    "test": "node --test --test-concurrency=1 tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.10",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
