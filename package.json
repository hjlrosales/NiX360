{
  "name": "nix360-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "worker": "npm run worker --workspace server",
    "migrate": "npm run migrate --workspace server",
    "backup": "node server/src/scripts/backup.ts",
    "bootstrap-admin": "npm run bootstrap-admin --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web",
    "lint": "eslint .",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
