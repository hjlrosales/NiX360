# Copy to .env and adjust. Never commit real credentials.

# Host-side paths (used by docker compose).
NIX_DATA_HOST=./data
MEDIA_PHOTOS=./media/photos
MEDIA_VIDEOS=./media/videos
NIX_PUBLISH_PORT=8787
PUID=1000
PGID=1000

# Optional environment-managed owner. Uncomment all three to create/synchronize
# an administrator at API startup. Changing the password revokes that user's
# existing sessions. Keep the real .env private and never commit its password.
# NIX_OWNER_LOGIN=owner
# NIX_OWNER_DISPLAY_NAME=Owner
# NIX_OWNER_PASSWORD=replace-with-a-unique-passphrase-of-at-least-12-characters

# Container-side media roots. These must match the compose mount points and are
# only ever mounted read-only. Clients cannot submit paths.
NIX_MEDIA_ROOTS=[{"id":"photos","name":"Photos","path":"/media/photos"},{"id":"videos","name":"Videos","path":"/media/videos"}]

# Public origin used for cookie security and CSRF origin checks. Terminate TLS
# in the DSM reverse proxy (or Nginx) and keep the published app port on
# loopback; TRUST_PROXY is only safe in that topology.
NIX_PUBLIC_ORIGIN=https://nix.example.com
NIX_COOKIE_SECURE=true
NIX_TRUST_PROXY=true

NIX_SESSION_IDLE_MINUTES=240
NIX_SESSION_ABSOLUTE_DAYS=30
NIX_LOGIN_RATE_LIMIT_MAX=10
NIX_LOG_LEVEL=info

# Administrative scan pacing: files modified more recently than this are left
# for the next scan so partially copied files are not probed.
NIX_STABILITY_WINDOW_SECONDS=60

# Scheduled reconciliation scans, in minutes per root. 0 disables scheduling;
# manual scans are always available from the admin page.
NIX_SCAN_INTERVAL_MINUTES=0

# Refuse new thumbnail/encode/tile work when the data filesystem has less free
# space than this. Jobs retry later instead of filling the volume or publishing
# partial output. Set to 0 only for a deliberate no-reserve test.
NIX_MIN_FREE_MB=512
